{
  "name": "lm-pipe",
  "displayName": "LM_Pipe",
  "description": "A local coding agent for Apple Silicon: Qwen3 in-process via MLX.",
  "version": "2.0.0",
  "publisher": "lm-pipe",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Machine Learning"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:lmPipe.sidebar",
    "onCommand:lmPipe.start",
    "onCommand:lmPipe.cancel"
  ],
  "contributes": {
    "commands": [
      { "command": "lmPipe.start", "title": "LM_Pipe: Start a run" },
      { "command": "lmPipe.cancel", "title": "LM_Pipe: Cancel the current run" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "lmPipe", "title": "LM_Pipe", "icon": "resources/icon.svg" }
      ]
    },
    "views": {
      "lmPipe": [{ "type": "webview", "id": "lmPipe.sidebar", "name": "Agent" }]
    },
    "configuration": {
      "title": "LM_Pipe",
      "properties": {
        "lmPipe.modelDir": {
          "type": "string", "default": "",
          "description": "Absolute path to the Qwen3 MLX model directory. Required; there is no default model (S7.5)."
        },
        "lmPipe.draftModelDir": {
          "type": "string", "default": "",
          "description": "Optional smaller Qwen for speculative decoding. Empty disables it."
        },
        "lmPipe.quantization": {
          "type": "string", "default": "4bit-experts",
          "enum": ["4bit-experts", "4bit", "8bit"],
          "description": "Quantisation. Both quality and speed must be MEASURED before changing this, never assumed (S5.11)."
        },
        "lmPipe.mode": {
          "type": "string", "default": "agent", "enum": ["plan", "debug", "agent"],
          "enumDescriptions": [
            "T0: no execution, no writes.",
            "T1 sandbox: may run commands, may not mutate the workspace.",
            "T1 sandbox: may run commands and mutate the workspace."
          ]
        },
        "lmPipe.sandboxTier": {
          "type": "number", "default": 1, "enum": [0, 1, 2],
          "enumDescriptions": [
            "T0 - no execution.",
            "T1 - macOS Seatbelt: writes jailed to the workspace, egress denied.",
            "T2 - container. REQUIRED for unattended runs (S7.2); refuses until wired."
          ]
        },
        "lmPipe.requireApproval": { "type": "boolean", "default": true },
        "lmPipe.hitl.autoApproveBelowRisk": { "type": "number", "default": 0.35 },
        "lmPipe.hitl.rejectAboveRisk": { "type": "number", "default": 0.85 },
        "lmPipe.sampling.temperature": { "type": "number", "default": 0.6 },
        "lmPipe.sampling.topP": { "type": "number", "default": 0.95 },
        "lmPipe.sampling.topK": { "type": "number", "default": 20 },
        "lmPipe.sampling.minP": { "type": "number", "default": 0.0 },
        "lmPipe.sampling.repetitionPenalty": { "type": "number", "default": 1.05 },
        "lmPipe.sampling.seed": { "type": "number", "default": 0 },
        "lmPipe.maxIterations": { "type": "number", "default": 40 },
        "lmPipe.wallClockSeconds": { "type": "number", "default": 900 },
        "lmPipe.contextBudgetTokens": { "type": "number", "default": 96000 },
        "lmPipe.egressPolicy": {
          "type": "string", "default": "deny", "enum": ["deny"],
          "description": "Egress is denied in the sandbox profile itself, not by inspecting commands (S7.4). There is no allow option."
        },
        "lmPipe.telemetry": { "type": "boolean", "default": false },
        "lmPipe.logLevel": {
          "type": "string", "default": "info", "enum": ["error", "warn", "info", "debug"]
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "stage-sidecar": "node scripts/stage-sidecar.js",
    "vscode:prepublish": "npm run compile && npm run stage-sidecar",
    "package": "vsce package --no-dependencies --allow-missing-repository --out lm-pipe.vsix",
    "install-local": "npm run package && node scripts/install-local.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0",
    "vsce": "^2.15.0"
  }
}
