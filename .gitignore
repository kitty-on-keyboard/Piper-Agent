# Build output
build/
build-*/
out/
dist/
node_modules/

# Extension packaging products. bin/ holds the sidecar STAGED from build/ by
# scripts/stage-sidecar.js -- it is a copy of a build artifact, never a source.
/extension/bin/
/extension/*.vsix
__pycache__/
*.o
*.a
*.dylib

# CTest run artifacts. Root-anchored: core.ignorecase=true on macOS, so a bare
# "Testing/" would also swallow a src/testing/ directory.
/Testing/

# Logs and temp files
*.log
# ...except the log-triage corpus, where the captured build output IS the
# benchmark. Without this negation the 32 committed logs are silently dropped
# and corpus.jsonl points at files that do not exist on a fresh clone -- the
# benchmark would look committed and be unrunnable. tests/bakeoff/
# test_corpus_loads.cpp asserts every referenced log opens and matches its
# pinned byte count, so this negation failing is a test failure, not a mystery.
!bakeoff/log_triage/logs/*.log
!bakeoff/log_triage/holdout_logs/*.log
*.tmp
*.swp

# Environment
.env
.env.local

# System
.DS_Store

# Sidecar event log: written into the CWD of whoever launched it (S6), so it
# appears at the repo root or in extension/ depending on how it was started.
lmp_events.jsonl
