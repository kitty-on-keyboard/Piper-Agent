# Build output
build/
build-*/
out/
dist/
node_modules/

# Extension packaging products. bin/ holds the sidecar STAGED from build/ by
# scripts/stage-sidecar.js -- it is a copy of a build artifact, never a source.
/extension/bin/
/extension/*.vsix
__pycache__/
*.o
*.a
*.dylib

# clangd's index, written next to compile_commands.json. 6.5 MB of machine-local
# binary that has no business in a diff.
/.cache/

# CTest run artifacts. Root-anchored: core.ignorecase=true on macOS, so a bare
# "Testing/" would also swallow a src/testing/ directory.
/Testing/

# Logs and temp files
*.log
# ...except the log-triage corpus, where the captured build output IS the
# benchmark. Without this negation the 32 committed logs are silently dropped
# and corpus.jsonl points at files that do not exist on a fresh clone -- the
# benchmark would look committed and be unrunnable. tests/corpus/
# test_corpus_loads.cpp asserts every referenced log opens and matches its
# pinned byte count, so this negation failing is a test failure, not a mystery.
!tests/testdata/log_triage/logs/*.log
!tests/testdata/log_triage/holdout_logs/*.log
*.tmp
*.swp

# Environment
.env
.env.local

# System
.DS_Store
.cursor/*
!.cursor/rules/
!.cursor/skills/

# Local-only safety copy made before history rewrite. Never commit.
/.oss-backup/

# Sidecar event log (S6). It goes to ~/Library/Logs/LM_Pipe/ now, so it no longer
# lands in the repo -- kept because $LMP_EVENT_LOG can still point anywhere, and
# because a tree that predates that change may still have one lying around.
lmp_events.jsonl

# Local agent-loop wins benches / multi-MB journals (see docs/AGENT_LOOP_WINS_BRANCH_PLAN.md).
# Keep summarize_events.py in scripts/; never commit raw dumps.
/piper-bench/
.piper/slices/
.piper/orch_webhook

